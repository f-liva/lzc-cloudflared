#!/bin/sh
# Config API for the web UI. Two actions, both JSON:
#   GET  ?a=status  -> runtime state + current settings
#   POST ?a=save    -> write /config/config.json, then restart cloudflared
#
# State lives in ONE place, /config/config.json, so the UI and the entrypoint
# cannot disagree. Env vars stay as the fallback when a key is absent, which
# keeps manifest-only installs working exactly as before.
CONF=/config/config.json
STATUS=/tmp/cf-status

json_get() { # json_get <key> <file>  (flat string values only)
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$2" 2>/dev/null | head -1
}
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

say() { printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n%s\n' "$1"; }

case "$QUERY_STRING" in
*a=status*)
  PID=$(pgrep -f 'cloudflared tunnel' | head -1)
  RUN=false; UPSEC=0
  if [ -n "$PID" ]; then
    RUN=true
    # /proc/<pid>/stat field 22 = starttime in clock ticks since boot
    ST=$(awk '{print $22}' /proc/$PID/stat 2>/dev/null)
    BOOT=$(awk '{print int($1)}' /proc/uptime)
    [ -n "$ST" ] && UPSEC=$((BOOT - ST / 100))
  fi
  CONN=null
  M=$(wget -qO- "http://127.0.0.1:${METRICS_PORT:-36501}/metrics" 2>/dev/null)
  if [ -n "$M" ]; then
    CONN=$(printf '%s' "$M" | awk '/^cloudflared_tunnel_ha_connections /{print int($2)}' | head -1)
    [ -z "$CONN" ] && CONN=null
  fi
  # grep -c exits 1 on zero matches, so "|| echo 0" would print TWO numbers
  # and break the JSON. Count with awk instead: always one line, always 0+.
  RETRY=$(awk '/Retrying connection/{n++} END{print n+0}' "$STATUS" 2>/dev/null)
  [ -z "$RETRY" ] && RETRY=0
  VER=$(cloudflared --version 2>/dev/null | awk '{print $3}')
  TOK=$(json_get token "$CONF"); HAS=false; [ -n "$TOK" ] && HAS=true
  PROTO=$(json_get protocol "$CONF"); [ -z "$PROTO" ] && PROTO="${PROTOCOL:-quic}"
  HA=$(json_get ha_connections "$CONF"); [ -z "$HA" ] && HA="${HA_CONNECTIONS:-1}"
  DNS=$(json_get dns_fallback "$CONF")
  [ -z "$DNS" ] && DNS="${DNS_FALLBACK-1.1.1.1 1.0.0.1}"
  say "{\"running\":$RUN,\"uptime\":$UPSEC,\"connections\":$CONN,\"retries\":$RETRY,\"version\":\"$(esc "$VER")\",\"has_token\":$HAS,\"protocol\":\"$(esc "$PROTO")\",\"ha_connections\":\"$(esc "$HA")\",\"dns_fallback\":\"$(esc "$DNS")\"}"
  ;;
*a=save*)
  [ "$REQUEST_METHOD" = POST ] || { say '{"ok":false,"error":"serve POST"}'; exit 0; }
  [ "${CONTENT_LENGTH:-0}" -gt 20000 ] && { say '{"ok":false,"error":"richiesta troppo grande"}'; exit 0; }
  BODY=$(dd bs=1 count="${CONTENT_LENGTH:-0}" 2>/dev/null)

  field() { # urldecoded value of <name> from the form body
    v=$(printf '%s' "$BODY" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1)
    v=$(printf '%s' "$v" | sed 's/+/ /g; s/%\(..\)/\\x\1/g')
    printf '%b' "$v"
  }
  TOKEN=$(field token); PROTO=$(field protocol); HA=$(field ha_connections); DNS=$(field dns_fallback)

  # Validation at the trust boundary: these end up on a command line.
  case "$PROTO" in quic|http2|auto) ;; *) say '{"ok":false,"error":"protocollo non valido"}'; exit 0;; esac
  case "$HA" in 1|2|3|4) ;; *) say '{"ok":false,"error":"connessioni: valore da 1 a 4"}'; exit 0;; esac
  for s in $DNS; do
    echo "$s" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || { say '{"ok":false,"error":"resolver non valido: '"$(esc "$s")"'"}'; exit 0; }
  done
  if [ -n "$TOKEN" ]; then
    echo "$TOKEN" | grep -qE '^[A-Za-z0-9+/=_-]{40,}$' || { say '{"ok":false,"error":"il token non ha un formato valido"}'; exit 0; }
  else
    TOKEN=$(json_get token "$CONF")
    [ -z "$TOKEN" ] && { say '{"ok":false,"error":"serve il token del tunnel"}'; exit 0; }
  fi

  # Write via temp file + mv: a crash mid-write must not leave a config
  # that no longer contains the token.
  mkdir -p /config
  TMP=/config/.config.json.$$
  cat > "$TMP" <<EOF
{
  "token": "$(esc "$TOKEN")",
  "protocol": "$(esc "$PROTO")",
  "ha_connections": "$(esc "$HA")",
  "dns_fallback": "$(esc "$DNS")"
}
EOF
  chmod 600 "$TMP" && mv "$TMP" "$CONF" || { rm -f "$TMP"; say '{"ok":false,"error":"scrittura della configurazione fallita"}'; exit 0; }

  # The entrypoint loop re-reads the config on every restart, so killing
  # cloudflared is the whole "apply".
  pkill -f 'cloudflared tunnel' 2>/dev/null
  say '{"ok":true}'
  ;;
*)
  say '{"ok":false,"error":"azione sconosciuta"}'
  ;;
esac
